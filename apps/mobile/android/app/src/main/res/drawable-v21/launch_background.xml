<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen: the app's page colour with the 4draws mark in the middle, until Flutter draws its first frame.
     (Android 12 and later draw the app icon over windowSplashScreenBackground instead.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item android:drawable="@drawable/launch_mark" android:gravity="center" android:width="96dp" android:height="96dp" />
</layer-list>
