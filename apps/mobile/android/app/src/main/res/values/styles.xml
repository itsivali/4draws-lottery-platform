<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app starts: the page colour and the mark. The app has one light theme, so this is the same
         in the system's dark mode (no dark flash before a light app). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter view once it runs (seen when the window resizes, for the keyboard for one). -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
