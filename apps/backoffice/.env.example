# Copy to .env.local for `npm run dev` against the local stack (scripts/dev-backend.sh).
VITE_API_BASE_URL=http://localhost:8080
# The local staff realm stands in for Google and Apple sign-in (ADR 0018). Never set these in a deployed build.
VITE_DEV_OIDC_AUTHORITY=http://localhost:8081/realms/lottery-staff
VITE_DEV_OIDC_CLIENT_ID=lottery-backoffice
# Optional, to try the real buttons: the back office's Google OAuth web client id (allow http://localhost:5173) and its
# Sign in with Apple Services ID (Apple needs an https address, so Apple cannot be tried on localhost).
# VITE_GOOGLE_CLIENT_ID=
# VITE_APPLE_CLIENT_ID=
