# Copy to .env.sandbox (gitignored) for scripts/dev-backend.sh --sandbox: real STK prompts from the Daraja sandbox.
# From your app on https://developer.safaricom.co.ke (My Apps). Sandbox credentials only, never production ones.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
